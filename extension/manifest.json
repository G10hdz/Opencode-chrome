{
  "manifest_version": 3,
  "name": "opencode-chrome",
  "version": "0.1.0",
  "description": "Control de Chrome para opencode via puente local (chrome.debugger/CDP).",
  "permissions": ["alarms", "debugger", "storage", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
